{
  "name": "@sunbigfly/dsh-multi-user-service",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Server-side multi-user extension for DSH: individual accounts, per-user permissions, private conversations and files, and usage and concurrency limits on one shared server.",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./member-host": "./member-host.mjs",
    "./tool-origins": "./carrier/tool-origins.mjs",
    "./tool-origins/locale/*.json": "./locale/tool-origins/*.json",
    "./tool-origins/icon": "./assets/logo-icon.png",
    "./core": "./core/service.js",
    "./cli-tools": "./cli-tools.mjs",
    "./cli-tools/locale/*.json": "./locale/cli-tools/*.json",
    "./cli-tools/icon": "./assets/logo-icon.png",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/logo-icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cli-tools.mjs",
    "member-host.mjs",
    "http.js",
    "domain-store.js",
    "client.js",
    "native-client.js",
    "core/*.js",
    "runtime/*.mjs",
    "runtime/*.js",
    "carrier/*.mjs",
    "!carrier/execution-native.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "locale/tool-origins/*.json",
    "locale/cli-tools/*.json",
    "assets/logo-icon.png",
    "assets/logo.png",
    "docs/operations.md",
    "ops/*.py",
    "ops/*.mjs",
    "ops/*.sh",
    "ops/*.service",
    "ops/*.timer",
    "ops/*.vbs",
    "README.md",
    "CONTRACT.md",
    "LICENSE",
    "docs/store-verification.md",
    "docs/completeness-2026-10-28.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check cli-tools.mjs && node --check carrier/cli-tools.mjs && node --check carrier/cli-management.mjs && node --check carrier/execution-catalog.mjs && node --check carrier/execution-tools.mjs && node --check member-host.mjs && node --check http.js && node --check domain-store.js && node --check client.js && node --check native-client.js && node --check carrier/browser-access.mjs && node --check core/service.js && node --check core/store.js && node --check core/lifecycle.js",
    "release:index": "node scripts/build-market-index.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "smol-toml": "1.9.1",
    "ws": "^8.21.3",
    "zod": "4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "node": ">=22",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.2.1-rc.1": "unknown",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "unknown"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunbigfly/dsh-multi-user-service.git"
  },
  "homepage": "https://github.com/sunbigfly/dsh-multi-user-service#readme",
  "bugs": {
    "url": "https://github.com/sunbigfly/dsh-multi-user-service/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "multi-user",
    "team",
    "permissions",
    "self-hosted"
  ]
}
