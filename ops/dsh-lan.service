[Unit]
Description=DSH Multi-User Service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@DSH_LAN_ROOT@
ExecStart=/bin/bash @DSH_LAN_SERVE@
Restart=always
RestartSec=5
RestartPreventExitStatus=73
TimeoutStopSec=45
KillMode=control-group
UMask=0077
StandardOutput=append:%h/.local/share/dsh-lan/dsh-lan.log
StandardError=append:%h/.local/share/dsh-lan/dsh-lan.log

[Install]
WantedBy=default.target
